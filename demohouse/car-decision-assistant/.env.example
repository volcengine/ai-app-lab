# Server-only Agent Plan credential. Never expose this value to client code.
AGENT_PLAN_API_KEY=

# Optional overrides. The defaults target the Agent Plan endpoints documented
# in this cookbook's source material.
AGENT_PLAN_MODEL=ark-code-latest
AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
DATAPRO_MCP_URL=https://datapro.hqd.cn-beijing.volces.com/mcp

# Project persistence. Keep service-role credentials on the server only.
PROJECT_STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Used only by the local byted-supabase-cli startup helper.
SUPABASE_WORKSPACE_ID=
SUPABASE_CLI_PROFILE=
SUPABASE_REGION=cn-beijing

# Optional override for the real Provider acceptance script.
CAR_DECISION_BASE_URL=http://localhost:3003
