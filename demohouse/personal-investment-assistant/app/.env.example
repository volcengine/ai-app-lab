# 将实际配置写入 ~/.config/investment-assistant/credentials.env。
# 默认只需填写 ARK_API_KEY；Agent Plan Harness 使用同一 Key 调用模型、DataPro 和豆包搜索。
# DATAPRO_API_KEY 与 WEB_SEARCH_API_KEY 仅用于明确需要独立覆盖凭证的高级场景。
# 不要提交真实凭证。
ARK_API_KEY=
DATAPRO_API_KEY=
WEB_SEARCH_API_KEY=

# Agent Plan 默认值。不同账号可能需要 /api/v3 和具体 Endpoint ID。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=doubao-seed-evolving
DATAPRO_MCP_URL=https://datapro.hqd.cn-beijing.volces.com/mcp
WEB_SEARCH_URL=https://open.feedcoopapi.com/search_api/web_search

APP_HOST=127.0.0.1
APP_PORT=8788
WEB_ORIGIN=http://127.0.0.1:5174
APP_TIMEZONE=Asia/Shanghai
ENABLE_SCHEDULER=true
PROVIDER_RETRY_COUNT=2
# 成功的真实 Provider 探测默认在 15 分钟内有效。
PROVIDER_HEALTH_TTL_MS=900000
