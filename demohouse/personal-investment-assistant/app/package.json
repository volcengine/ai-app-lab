{
  "name": "@investment-assistant/app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch src/server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
