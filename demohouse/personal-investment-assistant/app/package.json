    "helmet": "^8.1.0",
    "jsonrepair": "3.15.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supertest": "^7.1.1",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@hono/node-server": "2.0.10"
